import React, { useState } from 'react';
import { Package, ShoppingCart, Plus, RefreshCw, Layers } from 'lucide-react';

interface Batch {
  id: string;
  lotNumber: string;
  quantity: number;
  costPrice: number;
  receivedDate: string;
}

interface Product {
  id: string;
  name: string;
  barcode: string;
  sellingPrice: number;
  batches: Batch[];
}

export default function App() {
  const [products, setProducts] = useState<Product[]>([
    {
      id: '1',
      name: 'นมสด 1L',
      barcode: '8850001',
      sellingPrice: 45,
      batches: [
        { id: 'b1', lotNumber: 'LOT-001', quantity: 10, costPrice: 30, receivedDate: '2026-03-01' },
        { id: 'b2', lotNumber: 'LOT-002', quantity: 15, costPrice: 32, receivedDate: '2026-03-05' },
      ]
    }
  ]);

  const [productName, setProductName] = useState('');
  const [sellingPrice, setSellingPrice] = useState('');
  const [quantity, setQuantity] = useState('');
  const [costPrice, setCostPrice] = useState('');
  const [selectedProductId, setSelectedProductId] = useState('');
  const [sellQuantity, setSellQuantity] = useState('');

  // เพิ่มสินค้าใหม่ หรือ เพิ่มล็อตสินค้า (FIFO)
  const handleAddStock = (e: React.FormEvent) => {
    e.preventDefault();
    if (!productName || !sellingPrice || !quantity || !costPrice) return;

    const newBatch: Batch = {
      id: Date.now().toString(),
      lotNumber: `LOT-${Math.floor(1000 + Math.random() * 9000)}`,
      quantity: Number(quantity),
      costPrice: Number(costPrice),
      receivedDate: new Date().toISOString().split('T')[0]
    };

    const existingProduct = products.find(p => p.name.trim() === productName.trim());

    if (existingProduct) {
      setProducts(products.map(p => 
        p.id === existingProduct.id 
          ? { ...p, batches: [...p.batches, newBatch] }
          : p
      ));
    } else {
      const newProduct: Product = {
        id: Date.now().toString(),
        name: productName,
        barcode: Math.floor(100000000000 + Math.random() * 90000000000).toString(),
        sellingPrice: Number(sellingPrice),
        batches: [newBatch]
      };
      setProducts([...products, newProduct]);
    }

    setProductName('');
    setSellingPrice('');
    setQuantity('');
    setCostPrice('');
  };

  // ขายสินค้าแบบ FIFO (ตัดล็อตที่เข้าก่อนสุดออกก่อน)
  const handleSellProduct = (e: React.FormEvent) => {
    e.preventDefault();
    let qtyToSell = Number(sellQuantity);
    if (!selectedProductId || qtyToSell <= 0) return;

    setProducts(products.map(product => {
      if (product.id !== selectedProductId) return product;

      const updatedBatches: Batch[] = [];
      for (const batch of product.batches) {
        if (qtyToSell <= 0) {
          updatedBatches.push(batch);
        } else if (batch.quantity <= qtyToSell) {
          qtyToSell -= batch.quantity;
        } else {
          updatedBatches.push({ ...batch, quantity: batch.quantity - qtyToSell });
          qtyToSell = 0;
        }
      }

      return { ...product, batches: updatedBatches };
    }));

    setSellQuantity('');
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '900px', margin: '0 auto' }}>
      <h1>📦 ระบบจัดการสต็อกสินค้า (FIFO)</h1>
      
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px', marginBottom: '30px' }}>
        {/* ฟอร์มรับของเข้าสต็อก */}
        <div style={{ border: '1px solid #ccc', padding: '15px', borderRadius: '8px' }}>
          <h3><Plus size={18} /> บันทึกรับสินค้าเข้าสต็อก</h3>
          <form onSubmit={handleAddStock} style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            <input type="text" placeholder="ชื่อสินค้า" value={productName} onChange={e => setProductName(e.target.value)} required />
            <input type="number" placeholder="ราคาขาย (บาท)" value={sellingPrice} onChange={e => setSellingPrice(e.target.value)} required />
            <input type="number" placeholder="จำนวนที่รับเข้า" value={quantity} onChange={e => setQuantity(e.target.value)} required />
            <input type="number" placeholder="ราคาทุนต่อชิ้น" value={costPrice} onChange={e => setCostPrice(e.target.value)} required />
            <button type="submit" style={{ padding: '8px', background: '#22c55e', color: '#fff', border: 'none', borderRadius: '4px', cursor: 'pointer' }}>บันทึกสต็อก</button>
          </form>
        </div>

        {/* ฟอร์มตัดสต็อกตามขาย */}
        <div style={{ border: '1px solid #ccc', padding: '15px', borderRadius: '8px' }}>
          <h3><ShoppingCart size={18} /> ขายสินค้า (ตัดแบบ FIFO)</h3>
          <form onSubmit={handleSellProduct} style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            <select value={selectedProductId} onChange={e => setSelectedProductId(e.target.value)} required>
              <option value="">-- เลือกสินค้า --</option>
              {products.map(p => (
                <option key={p.id} value={p.id}>{p.name}</option>
              ))}
            </select>
            <input type="number" placeholder="จำนวนที่ขาย" value={sellQuantity} onChange={e => setSellQuantity(e.target.value)} required />
            <button type="submit" style={{ padding: '8px', background: '#3b82f6', color: '#fff', border: 'none', borderRadius: '4px', cursor: 'pointer' }}>บันทึกการขาย</button>
          </form>
        </div>
      </div>

      {/* รายการสต็อกและล็อตสินค้า */}
      <h2><Layers size={20} /> รายการสินค้าและล็อตในสต็อก</h2>
      {products.map(product => {
        const totalStock = product.batches.reduce((acc, b) => acc + b.quantity, 0);
        return (
          <div key={product.id} style={{ border: '1px solid #e5e7eb', padding: '15px', borderRadius: '8px', marginBottom: '15px' }}>
            <h3>{product.name} (คงเหลือรวม: {totalStock} ชิ้น) - ราคาขาย {product.sellingPrice} บาท</h3>
            <h4>รายการล็อต (FIFO):</h4>
            <ul>
              {product.batches.map(batch => (
                <li key={batch.id}>
                  <strong>{batch.lotNumber}</strong> | วันที่รับ: {batch.receivedDate} | เหลือ: {batch.quantity} ชิ้น | ราคาทุน: {batch.costPrice} บาท
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  );
}
